@model List<RaceDayMVC.Controllers.MyEnrollmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Enrolments</h2>
            <p class="text-muted">
                View the events you have successfully enrolled in.
            </p>
        </div>

        <a asp-controller="Participant"
           asp-action="BrowseEvents"
           class="btn btn-primary">
            Browse Events
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No Enrolments Yet</h5>

                <p class="text-muted">
                    You have not enrolled in any events yet.
                    Browse available events to get started.
                </p>

                <a asp-controller="Participant"
                   asp-action="BrowseEvents"
                   class="btn btn-primary">
                    Browse Available Events
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <strong>Total Enrolments:</strong> @Model.Count
        </div>

        <div class="row">
            @foreach (var enrolment in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @enrolment.EventName
                            </h5>

                            <hr />

                            <p>
                                <strong>Event Date:</strong><br />
                                @enrolment.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong><br />
                                @enrolment.Location
                            </p>

                            <p>
                                <strong>Category:</strong><br />
                                @enrolment.CategoryName
                            </p>

                            <p>
                                <strong>Entry Fee:</strong><br />
                                R @enrolment.EntryFee.ToString("N2")
                            </p>

                            <p>
                                <strong>Enrolment Date:</strong><br />

                                @(enrolment.EnrolmentDate.HasValue
                                                        ? enrolment.EnrolmentDate.Value.ToString("dd MMMM yyyy")
                                                        : "Not available")
                    </p>

                            <p>
                                <strong>Status:</strong>

                        @if (enrolment.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @(enrolment.Status ?? "Unknown")
                                    </span>
                                }
                            </p>

                            <p class="text-muted small mb-0">
                                Enrolment Reference: #@enrolment.EnrolmentID
                            </p>

                        </div>
                    </div>

                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>
