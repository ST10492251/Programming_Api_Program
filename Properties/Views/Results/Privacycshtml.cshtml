@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <h1>RaceDay Privacy Policy</h1>

    <p>
        RaceDay respects the privacy of its users and is committed
        to protecting their personal information.
    </p>

    <h3>1. Information Collection</h3>
    <p>
        RaceDay collects information such as names, email addresses
        and event enrolment details when users register and use the platform.
    </p>

    <h3>2. Use of Information</h3>
    <p>
        Personal information is used to manage user accounts,
        event registrations, enrolments and race results.
    </p>

    <h3>3. Information Security</h3>
    <p>
        RaceDay takes reasonable steps to protect user information
        from unauthorised access and disclosure.
    </p>

    <h3>4. Contact</h3>
    <p>
        Users can contact the RaceDay administration team regarding
        questions about their personal information.
    </p>
</div>
