@model IEnumerable<RaceDayMVC.Models.EnrollmentViewModel>

@{
    ViewData["Title"] = "View Enrolments";
}

<div class="container mt-4">
    <h2>Event Enrolments</h2>
    <p class="text-muted">View participants registered for your events.</p>

    @* Success message *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @* Error message *@
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @* Information message *@
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info">
            @ViewBag.Message
        </div>
    }

    @* Display enrolments *@
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Event</th>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Category</th>
                        <th>Enrolled At</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrollment in Model)
                    {
                        <tr>
                            <td>@enrollment.ID</td>

                            <td>@enrollment.EventName</td>

                            <td>
                                @enrollment.Participant.FirstName
                                @enrollment.Participant.LastName
                            </td>

                            <td>@enrollment.Participant.Email</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(enrollment.Participant.Phone)
                                                        ? "Not provided"
                                                        : enrollment.Participant.Phone)
                                                                                   </td>

                            <td>@enrollment.CategoryName</td>

                            <td>
                                @(enrollment.EnrolledAt.ToLocalTime()
                                                        .ToString("dd MMM yyyy HH:mm") ?? "Not available")
                    </td>
                </tr>
                                }
                </tbody>
            </table>
        </div>
    }
    else if (ViewBag.ErrorMessage == null && ViewBag.Message == null)
    {
        <div class="alert alert-info">
            No enrolments have been recorded yet.
        </div>
    }

    @* Back to organiser dashboard *@
    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
